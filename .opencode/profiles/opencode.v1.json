{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000
  },
  "permission": {
    "skill": "allow",
    "external_directory": "ask",
    "lsp": "allow"
  },
  "lsp": {
    "r-languageserver": {
      "command": ["R", "--no-echo", "-e", "languageserver::run()"],
      "extensions": [".R", ".r", ".Rmd", ".rmd"]
    }
  }
}
